# ============================================================
# Semantic Cache — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Gemini API ──────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Redis ───────────────────────────────────────────────────
# Default works with the Redis service in docker-compose.yml
# (start it with: docker compose up -d)
REDIS_URL=redis://localhost:6379

# ── Embedding Model ────────────────────────────────────────
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
# How long a text's embedding is remembered, so the same text is never
# embedded twice (7 days; 0 turns the memory off).
EMBEDDING_CACHE_TTL_SECONDS=604800

# ── Cache Defaults ──────────────────────────────────────────
DEFAULT_SIMILARITY_THRESHOLD=0.95
DEFAULT_TTL_SECONDS=86400

# ── Intent Classifier ───────────────────────────────────────
CLASSIFIER_MODEL=gemini-3.5-flash-lite
CLASSIFIER_MODEL=gemini-3.1-flash-lite
CLASSIFIER_TIMEOUT_SECONDS=30

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Admin ───────────────────────────────────────────────────
# Protects POST /v1/cache/invalidate ("Authorization: Bearer <token>").
# Leave unset for local development; set it before exposing the proxy.
# ADMIN_TOKEN=change-me

# ── Tracing with Langfuse (optional) ────────────────────────
# Set both keys to record every request as a trace: the question, each
# step the cache took, and the answer. Leave them unset to keep it off.
# With tracing on, questions and answers are sent to the Langfuse server.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# Langfuse Cloud by default. Set this for another region or a self-hosted server
# (a self-hosted Langfuse defaults to port 3000, which Grafana uses here):
# LANGFUSE_BASE_URL=http://localhost:3001
